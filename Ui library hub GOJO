-- ไอคอน + ชื่อ + คำอธิบาย (ใช้ซ้ำใน Button/Toggle/Keybind ฯลฯ)
local function BuildLabels(f, cfg, defaultName, rightReserve, z)
	local icon = cfg.Icon or cfg.Image
	local desc = cfg.Description or cfg.Subtitle
	local hasDesc = desc ~= nil and tostring(desc) ~= ""
	local x = 14

	if icon ~= nil and icon ~= "" then
		local ic = GOJO.CreateIcon(icon, {
			Name = "ElementIcon",
			Size = UDim2.fromOffset(cfg.IconSize or 20, cfg.IconSize or 20),
			Position = UDim2.new(0, 14, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Color = cfg.IconColor,
			ZIndex = z,
		})
		if ic then ic.Parent = f x = 46 end
	end

	local Title = New("TextLabel", {
		Name = "Title",
		Position = hasDesc and UDim2.new(0, x, 0, 8) or UDim2.new(0, x, 0, 0),
		Size = hasDesc and UDim2.new(1, -(x + rightReserve), 0, 21) or UDim2.new(1, -(x + rightReserve), 1, 0),
		BackgroundTransparency = 1,
		Text = tostring(cfg.Name or defaultName),
		TextColor3 = cfg.TextColor or Theme.Text,
		TextSize = cfg.TextSize or 13,
		Font = Enum.Font.GothamSemibold,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = z,
		Parent = f,
	})

	local Detail
	if hasDesc then
		Detail = New("TextLabel", {
			Name = "Description",
			Position = UDim2.new(0, x, 0, 31),
			Size = UDim2.new(1, -(x + rightReserve), 0, 18),
			BackgroundTransparency = 1,
			Text = tostring(desc),
			TextColor3 = cfg.DescriptionColor or Theme.SubText,
			TextSize = cfg.DescriptionTextSize or 11,
			Font = Enum.Font.Gotham,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = z,
			Parent = f,
		})
	end
	return Title, Detail
end

--=========================================================
-- CREATE WINDOW
--=========================================================

function GOJO:CreateWindow(config)
	config = config or {}
	if config.Theme then GOJO:SetTheme(config.Theme) end
	if config.Intro ~= nil then GOJO.FX.Intro = config.Intro end

	local FX = GOJO.FX
	local Window = {}

	Window.Title = config.Title or "GOJO HUB"
	Window.Subtitle = config.Subtitle or "Limitless  \u{2022}  Infinity"
	Window.Size = config.Size or Vector2.new(700, 440)
	Window.MinSize = config.MinSize or Vector2.new(560, 360)
	Window.MaxSize = config.MaxSize or Vector2.new(1000, 650)
	Window.CurSize = Vector2.new(Window.Size.X, Window.Size.Y)
	Window.ToggleKey = config.ToggleKey or Enum.KeyCode.RightShift
	Window.Tabs = {}
	Window.IsHidden = false
	Window.IsMinimized = false
	Window.Destroyed = false
	Window.ConfirmOnClose = config.ConfirmOnClose ~= false

	local conns, gradients, updaters = {}, {}, {}

	local function Connect(signal, fn)
		local c = signal:Connect(fn)
		table.insert(conns, c)
		return c
	end

	local function Dragger(area, onUpdate)
		local active = false
		Connect(area.InputBegan, function(i)
			if IsPress(i) then active = true onUpdate(i) end
		end)
		Connect(UserInputService.InputChanged, function(i)
			if active and IsMove(i) then onUpdate(i) end
		end)
		Connect(UserInputService.InputEnded, function(i)
			if IsPress(i) then active = false end
		end)
	end

	-- ขอบไล่สี น้ำเงิน <-> ดำอ่อน (หมุนวน)
	local function BorderGrad(target, thickness)
		local st = New("UIStroke", {
			Parent = target,
			Thickness = thickness,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Color = Color3.new(1, 1, 1),
		})
		local g = New("UIGradient", {
			Parent = st,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Theme.Primary),
				ColorSequenceKeypoint.new(0.25, Theme.SoftBlack),
				ColorSequenceKeypoint.new(0.5, Theme.Glow),
				ColorSequenceKeypoint.new(0.75, Theme.SoftBlack),
				ColorSequenceKeypoint.new(1, Theme.Primary),
			}),
		})
		table.insert(gradients, g)
		return st, g
	end

	-- ลูกแก้ว Blue & Red โคจร
	local function Orbit(parent, radius, z)
		local orbs = {
			{ color = Theme.OrbA, phase = 0, speed = 1.8 },
			{ color = Theme.OrbB, phase = math.pi, speed = 1.8 },
		}
		for _, o in ipairs(orbs) do
			o.frame = New("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(7, 7),
				BackgroundColor3 = o.color,
				BorderSizePixel = 0,
				ZIndex = z or 8,
				Parent = parent,
			})
			Round(o.frame)
			New("UIStroke", { Color = o.color, Transparency = 0.5, Thickness = 3, Parent = o.frame })
		end
		table.insert(updaters, function(t)
			for _, o in ipairs(orbs) do
				local a = o.phase + t * o.speed
				o.frame.Position = UDim2.new(0.5, math.cos(a) * radius, 0.5, math.sin(a) * radius * 0.8)
				o.frame.Size = UDim2.fromOffset(7 + math.sin(a) * 2, 7 + math.sin(a) * 2)
			end
		end)
	end

	--=====================================================
	-- SCREEN GUI + MAIN
	--=====================================================

	local guiParent = GetParent()
	for _, c in ipairs(guiParent:GetChildren()) do
		if string.sub(c.Name, 1, 8) == "GOJO_UI_" then c:Destroy() end
	end

	local ScreenGui = New("ScreenGui", {
