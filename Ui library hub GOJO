--=========================================================

function GOJO.BuildIntro(Gui, TitleText, SubText)
	local FX = GOJO.FX
	if FX.IntroOnce and GOJO.IntroPlayed then return end
	GOJO.IntroPlayed = true

	local Root = New("Frame", {
		Name = "GojoIntro",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 200,
		Parent = Gui,
	})
	local function alive() return Root.Parent ~= nil end
	task.delay(9, function() if Root.Parent then Root:Destroy() end end)

	local Dim = New("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(2, 4, 12),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 200,
		Parent = Root,
	})

	local cx, cy = 0.5, 0.4

	local function Ring(delay)
		task.delay(delay, function()
			if not alive() then return end
			local r = New("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(cx, cy),
				Size = UDim2.fromOffset(20, 20),
				BackgroundTransparency = 1,
				ZIndex = 201,
				Parent = Root,
			})
			Round(r)
			local st = New("UIStroke", { Color = Theme.Glow, Thickness = 3, Transparency = 0.1, Parent = r })
			Tween(r, 1.2, { Size = UDim2.fromOffset(560, 560) }, Enum.EasingStyle.Quart)
			Tween(st, 1.2, { Transparency = 1, Thickness = 0.5 })
			task.delay(1.3, function() r:Destroy() end)
		end)
	end

	local Sym = New("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(cx, cy),
		Size = UDim2.fromOffset(220, 120),
		BackgroundTransparency = 1,
		Text = "\u{221E}",
		TextColor3 = Theme.Glow,
		TextTransparency = 1,
		TextSize = 96,
		Font = Enum.Font.GothamBlack,
		ZIndex = 203,
		Parent = Root,
	})
	local SymStroke = New("UIStroke", { Color = Theme.Primary, Thickness = 3, Transparency = 0.4, Parent = Sym })
	local SymScale = New("UIScale", { Scale = 0.3, Parent = Sym })

	local Eyes = {}
	local function Eye(dx, rot)
		local e = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(cx, dx, cy, 0),
			Size = UDim2.fromOffset(0, 6),
			BackgroundColor3 = Color3.fromRGB(200, 238, 255),
			BorderSizePixel = 0,
			Rotation = rot,
			ZIndex = 204,
			Parent = Root,
		})
		Round(e)
		local g = New("UIStroke", { Color = Theme.Primary, Thickness = 3, Transparency = 0.3, Parent = e })
		Tween(e, 0.35, { Size = UDim2.fromOffset(64, 6) }, Enum.EasingStyle.Back)
		table.insert(Eyes, { e, g })
	end

	local TitleLabel, TitleStroke, SubLabel

	task.spawn(function()
		pcall(function()
			Tween(Dim, 0.4, { BackgroundTransparency = 0.3 })
			task.wait(0.35)
			Ring(0) Ring(0.2) Ring(0.4)
			Tween(Sym, 0.5, { TextTransparency = 0 })
			Tween(SymScale, 0.6, { Scale = 1 }, Enum.EasingStyle.Back)
			task.wait(0.8)
			if not alive() then return end

			Eye(-125, -8)
			Eye(125, 8)
			task.wait(0.5)

			-- พิมพ์ชื่อทีละตัว
			local text = tostring(TitleText or "GOJO")
			TitleLabel = New("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.64),
				Size = UDim2.new(1, 0, 0, 56),
				BackgroundTransparency = 1,
				Text = "",
				TextColor3 = Theme.Text,
				TextSize = 42,
				Font = Enum.Font.GothamBlack,
				ZIndex = 205,
				Parent = Root,
			})
			TitleStroke = New("UIStroke", { Color = Theme.Primary, Thickness = 2.5, Transparency = 0.4, Parent = TitleLabel })
			SubLabel = New("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, 0, 0.64, 42),
				Size = UDim2.new(1, 0, 0, 20),
				BackgroundTransparency = 1,
				Text = tostring(SubText or ""),
				TextColor3 = Theme.Glow,
				TextTransparency = 1,
				TextSize = 15,
				Font = Enum.Font.GothamBold,
				ZIndex = 205,
				Parent = Root,
			})

			local count = utf8.len(text) or #text
			for i = 1, count do
				if not alive() then return end
				local cut = utf8.offset(text, i + 1)
				TitleLabel.Text = cut and string.sub(text, 1, cut - 1) or text
				task.wait(0.07)
			end
			Tween(SubLabel, 0.4, { TextTransparency = 0 })

			-- กะพริบ Six Eyes
			task.wait(0.5)
			for _, pair in ipairs(Eyes) do pair[1].Size = UDim2.fromOffset(64, 1) end
			task.wait(0.12)
			for _, pair in ipairs(Eyes) do pair[1].Size = UDim2.fromOffset(64, 6) end
			task.wait(1.0)

			-- เฟดออก
			Tween(Dim, 0.7, { BackgroundTransparency = 1 })
			Tween(Sym, 0.6, { TextTransparency = 1 })
			Tween(SymStroke, 0.6, { Transparency = 1 })
			for _, pair in ipairs(Eyes) do
				Tween(pair[1], 0.5, { BackgroundTransparency = 1 })
				Tween(pair[2], 0.5, { Transparency = 1 })
			end
			Tween(TitleLabel, 0.6, { TextTransparency = 1 })
			Tween(TitleStroke, 0.6, { Transparency = 1 })
			Tween(SubLabel, 0.6, { TextTransparency = 1 })
			task.wait(0.8)
		end)
		if Root.Parent then Root:Destroy() end
	end)
end

