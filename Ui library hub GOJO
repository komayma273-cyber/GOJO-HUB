					Tween(live, 0.6, { BackgroundTransparency = 0.7 })
					task.wait(0.6)
					Tween(live, 0.6, { BackgroundTransparency = 0 })
					task.wait(0.6)
				end
			end)

			if cfg.Aura ~= false then GOJO.Effects:Aura(f) end

			return { Frame = f, Avatar = big, Performance = perf, Update = updateInfo }
		end

		function Tab:CreateProfileCard(cfg)
			cfg = cfg or {}
			cfg.Compact = true
			return Tab:CreateInfoCard(cfg)
		end

		--=================================================
		-- SEARCH BOX (กรององค์ประกอบในแท็บนี้)
		--=================================================

		function Tab:CreateSearchBox(cfg)
			cfg = cfg or {}
			local f = MakeElement(68, cfg.Name, true)
			AddFieldLabel(f, cfg.Name or "Search", cfg.Description)
			local box = New("TextBox", {
				Position = UDim2.fromOffset(14, 28),
				Size = UDim2.new(1, -28, 0, 32),
				BackgroundColor3 = Theme.Background,
				Text = "",
				PlaceholderText = cfg.Placeholder or "Search...",
				PlaceholderColor3 = Theme.SubText,
				TextColor3 = Theme.Text,
				TextSize = 12,
				Font = Enum.Font.Gotham,
				ClearTextOnFocus = false,
				ZIndex = 3,
				Parent = f,
			})
			Corner(box, GOJO.Corners.Inner)
			Stroke(box, Theme.Line, 0.3, 1)
			box:GetPropertyChangedSignal("Text"):Connect(function()
				local q = string.lower(box.Text)
				for _, item in ipairs(Tab.Items) do
					item.Frame.Visible = (q == "") or (string.find(item.Key, q, 1, true) ~= nil)
				end
				if cfg.Callback then task.spawn(cfg.Callback, box.Text) end
			end)
			return { Frame = f, Input = box, Get = function() return box.Text end }
		end

		--=================================================
		-- COMMAND BOX
		--   Commands = { fly = function(args) end, ... }   Prefix = ":"
		--=================================================

		function Tab:CreateCommandBox(cfg)
			cfg = cfg or {}
			local prefix = cfg.Prefix or ":"
			local f = MakeElement(76, cfg.Name)
			AddFieldLabel(f, cfg.Name or "Command", cfg.Description)
			local box = New("TextBox", {
				Position = UDim2.fromOffset(14, 30),
				Size = UDim2.new(1, -94, 0, 34),
				BackgroundColor3 = Theme.Background,
				Text = "",
				PlaceholderText = cfg.Placeholder or (prefix .. "help"),
				PlaceholderColor3 = Theme.SubText,
				TextColor3 = Theme.Text,
				TextSize = 12,
				Font = Enum.Font.Code,
				ClearTextOnFocus = false,
				ZIndex = 3,
				Parent = f,
			})
			Corner(box, GOJO.Corners.Inner)
			Stroke(box, Theme.Line, 0.3, 1)

			local run = New("TextButton", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -14, 0, 30),
				Size = UDim2.fromOffset(64, 34),
				BackgroundColor3 = Theme.Primary,
				Text = "RUN",
				TextColor3 = Color3.new(1, 1, 1),
				TextSize = 11,
				Font = Enum.Font.GothamBold,
				AutoButtonColor = false,
				ZIndex = 3,
				Parent = f,
			})
			Corner(run, GOJO.Corners.Inner)
			HoverColor(run, Theme.Primary, Theme.Glow)

			local function execute()
				local text = box.Text
				if text == "" then return end
				local clean = text
				if string.sub(clean, 1, #prefix) == prefix then clean = string.sub(clean, #prefix + 1) end
				local name, args = clean:match("^%s*(%S+)%s*(.-)%s*$")
				local handler = cfg.Commands and name and cfg.Commands[string.lower(name)]
				if handler then
					task.spawn(handler, args)
				elseif cfg.Callback then
					task.spawn(cfg.Callback, text)
				end
			end

			run.Activated:Connect(execute)
			box.FocusLost:Connect(function(enter) if enter then execute() end end)

			return {
				Frame = f, Input = box, Run = execute,
				Get = function() return box.Text end,
				Set = function(_, t) box.Text = tostring(t or "") end,
			}
		end

		return Tab
	end

	--=====================================================
	-- OPENING
	--=====================================================

	HideScale.Scale = 0.85
	Tween(HideScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

	local introDelay = 0.5
	if FX.Intro and not (FX.IntroOnce and GOJO.IntroPlayed) then
		GOJO.BuildIntro(ScreenGui, Window.Title, Window.Subtitle)
		introDelay = 4.4
	end

	if config.Welcome ~= false then
		task.delay(introDelay, function()
			if not Window.Destroyed then
				Window:Notify({
					Title = Window.Title .. "  v" .. GOJO.Version,
					Content = config.WelcomeText or "Infinity loaded. Nothing can touch you.",
					Type = "success",
					Duration = 3.5,
				})
			end
		end)
	end

	return Window
end

