	function Window:Minimize(state)
		if Window.Destroyed or Window.IsHidden then return end
		if state == nil then state = not Window.IsMinimized end
		if state == Window.IsMinimized then return end
		Window.IsMinimized = state

		local fullH = Window.CurSize.Y
		local shift = (58 - fullH) / 2
		local pos = Main.Position

		if state then
			ResizeHandle.Visible = false
			Tween(Main, 0.3, {
				Size = UDim2.fromOffset(Window.CurSize.X, 58),
				Position = UDim2.new(pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset + shift),
			}, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
			MinimizeButton.Text = "+"
		else
			Tween(Main, 0.35, {
				Size = UDim2.fromOffset(Window.CurSize.X, Window.CurSize.Y),
				Position = UDim2.new(pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset - shift),
			}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			MinimizeButton.Text = "-"
			task.delay(0.36, function()
				if not Window.IsMinimized then ResizeHandle.Visible = true end
			end)
		end
	end

	function Window:Hide()
		if Window.Destroyed or Window.IsHidden then return end
		Window.IsHidden = true
		Tween(HideScale, 0.22, { Scale = 0.01 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.24, function()
			if Window.IsHidden and not Window.Destroyed then Main.Visible = false end
		end)
	end

	function Window:Show()
		if Window.Destroyed or not Window.IsHidden then return end
		Window.IsHidden = false
		Main.Visible = true
		HideScale.Scale = 0.85
		Tween(HideScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end

	function Window:ToggleVisibility()
		if Window.Destroyed then return end
		if Window.IsHidden then Window:Show() else Window:Hide() end
	end

	function Window:SetSize(w, h)
		if Window.Destroyed then return end
		w = math.clamp(w, Window.MinSize.X, Window.MaxSize.X)
		h = math.clamp(h, Window.MinSize.Y, Window.MaxSize.Y)
		Window.CurSize = Vector2.new(w, h)
		Tween(Main, 0.25, { Size = UDim2.fromOffset(w, h) })
	end

	function Window:Destroy()
		if Window.Destroyed then return end
		Window.Destroyed = true
		Tween(FloatScale, 0.2, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		local tw = Tween(HideScale, 0.28, { Scale = 0.01 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		tw.Completed:Connect(function()
			for _, c in ipairs(conns) do c:Disconnect() end
			ScreenGui:Destroy()
		end)
	end

