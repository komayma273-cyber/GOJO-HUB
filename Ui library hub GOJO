				ZIndex = 3,
				Parent = f,
			})
			Round(sw)
			local knob = New("Frame", {
				Position = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
				Size = UDim2.fromOffset(18, 18),
				BackgroundColor3 = Color3.new(1, 1, 1),
				ZIndex = 4,
				Parent = sw,
			})
			Round(knob)

			local obj = { Frame = f }
			local function render()
				Tween(sw, 0.18, { BackgroundColor3 = state and Theme.Primary or Theme.ToggleOff })
				Tween(knob, 0.18, {
					Position = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
				})
			end
			function obj:Set(v, silent)
				state = v and true or false
				render()
				if not silent and cfg.Callback then task.spawn(cfg.Callback, state) end
			end
			function obj:Get() return state end

			Hover(hit, f)
			hit.Activated:Connect(function() obj:Set(not state) end)
			if state and cfg.CallOnLoad and cfg.Callback then task.spawn(cfg.Callback, state) end
			return obj
		end

