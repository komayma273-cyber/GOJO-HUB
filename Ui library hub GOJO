		local function MakeDropdown(cfg, multi)
			cfg = cfg or {}
			local options = cfg.Options or {}
			local maxVisible = cfg.MaxVisible or 5
			local selected
			if multi then
				selected = {}
				for _, v in ipairs(cfg.Default or {}) do selected[v] = true end
			else
				selected = cfg.Default or options[1]
			end
			local open = false

			local f = MakeElement(48, cfg.Name)
			local head = Hit(f, 2)
			New("TextLabel", {
				Position = UDim2.fromOffset(14, 0),
				Size = UDim2.new(0.5, -14, 0, 48),
				BackgroundTransparency = 1,
				Text = cfg.Name or (multi and "Multi Select" or "Dropdown"),
				TextColor3 = Theme.Text,
				TextSize = 13,
				Font = Enum.Font.GothamSemibold,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = 3,
				Parent = f,
			})
			local Value = New("TextLabel", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -36, 0, 0),
				Size = UDim2.new(0.5, -40, 0, 48),
				BackgroundTransparency = 1,
				Text = "",
				TextColor3 = Theme.Glow,
				TextSize = 12,
				Font = Enum.Font.Gotham,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = 3,
				Parent = f,
			})
			local Arrow = New("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(1, -20, 0, 24),
				Size = UDim2.fromOffset(16, 16),
				BackgroundTransparency = 1,
				Text = "\u{25BC}",
				TextColor3 = Theme.Primary,
				TextSize = 10,
				Font = Enum.Font.GothamBold,
				ZIndex = 3,
				Parent = f,
			})
			local List = New("ScrollingFrame", {
				Position = UDim2.fromOffset(10, 52),
				Size = UDim2.new(1, -20, 0, 0),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 2,
				ScrollBarImageColor3 = Theme.Primary,
				CanvasSize = UDim2.new(),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ZIndex = 3,
				Parent = f,
			})
			New("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder, Parent = List })

			local buttons = {}

			local function valueText()
				if multi then
					local c = 0
					for _, s in pairs(selected) do if s then c += 1 end end
					return c .. " selected"
				end
				return tostring(selected or "Select")
			end

			local function result()
				if multi then
					local r = {}
					for _, o in ipairs(options) do if selected[o] then table.insert(r, o) end end
					return r
				end
				return selected
			end

			local function paint()
				Value.Text = valueText()
				for opt, b in pairs(buttons) do
					local on = (multi and selected[opt]) or (not multi and selected == opt)
					b.TextColor3 = on and Theme.Text or Theme.SubText
					b.BackgroundTransparency = on and 0.25 or 0.75
					b.Text = ((multi and on) and "\u{2713}  " or "") .. tostring(opt)
				end
			end

			local function listHeight() return math.min(#options, maxVisible) * 33 end

			local function setOpen(v)
				open = v
				List.Size = UDim2.new(1, -20, 0, listHeight())
				Tween(f, 0.22, { Size = UDim2.new(1, 0, 0, 48 + (v and (listHeight() + 10) or 0)) })
				Tween(Arrow, 0.22, { Rotation = v and 180 or 0 })
			end

			local function build()
				for _, c in ipairs(List:GetChildren()) do
					if c:IsA("TextButton") then c:Destroy() end
				end
				buttons = {}
				for i, opt in ipairs(options) do
					local b = New("TextButton", {
						Size = UDim2.new(1, -4, 0, 30),
						BackgroundColor3 = Theme.CardHover,
						BackgroundTransparency = 0.75,
						Text = tostring(opt),
						TextColor3 = Theme.SubText,
						TextSize = 12,
						Font = Enum.Font.Gotham,
						AutoButtonColor = false,
						LayoutOrder = i,
						ZIndex = 4,
						Parent = List,
					})
					Corner(b, 6)
					buttons[opt] = b
					b.Activated:Connect(function()
						if multi then
							selected[opt] = not selected[opt]
						else
							selected = opt
							setOpen(false)
						end
						paint()
						if cfg.Callback then task.spawn(cfg.Callback, result()) end
					end)
				end
				paint()
			end

			Hover(head, f)
			head.Activated:Connect(function() setOpen(not open) end)
			build()

			return {
				Frame = f,
				Get = result,
				Set = function(_, v)
					if multi then
						selected = {}
						for _, o in ipairs(v or {}) do selected[o] = true end
					else
						selected = v
					end
					paint()
				end,
				SetOptions = function(_, newOptions)
					options = newOptions or {}
					if not multi and selected == nil then selected = options[1] end
					build()
					if open then setOpen(true) end
				end,
			}
		end

