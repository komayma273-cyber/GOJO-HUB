function GOJO:SetTheme(name)
	local key = tostring(name or "blue"):lower():gsub("^%l", string.upper)
	if not self.Themes[key] then key = "Blue" end
	Theme = self.Themes[key]
	self.Theme = Theme
	self.ThemeName = key
	return Theme
end

