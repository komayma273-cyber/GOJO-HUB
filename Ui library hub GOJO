			local Fill = New("Frame", {
				Size = UDim2.fromScale(0, 1),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				ZIndex = 4,
				Parent = Bar,
			})
			Round(Fill)
			New("UIGradient", { Color = ColorSequence.new(Theme.Primary, Theme.Glow), Parent = Fill })
			local Knob = New("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(1, 0.5),
				Size = UDim2.fromOffset(14, 14),
				BackgroundColor3 = Color3.new(1, 1, 1),
				ZIndex = 5,
				Parent = Fill,
			})
			Round(Knob)
			Stroke(Knob, Theme.Primary, 0.3, 2)

			local obj = { Frame = f }
			local function setValue(v, silent)
				v = math.floor(v / inc + 0.5) * inc
				v = math.clamp(tonumber(string.format("%.4f", v)), min, max)
				value = v
				Fill.Size = UDim2.fromScale((v - min) / (max - min), 1)
				ValueLabel.Text = tostring(v) .. suffix
				if not silent and cfg.Callback then task.spawn(cfg.Callback, v) end
			end
			function obj:Set(v) setValue(v) end
			function obj:Get() return value end

			local hit = New("TextButton", {
				Position = UDim2.fromOffset(8, 34),
				Size = UDim2.new(1, -16, 0, 26),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				ZIndex = 6,
				Parent = f,
			})
			Dragger(hit, function(i)
				local p = math.clamp((i.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
				setValue(min + (max - min) * p)
			end)
			setValue(value, true)
			return obj
		end

