local LucideModule, LucideTried

local function GetLucide()
	if LucideTried then return LucideModule end
	LucideTried = true
	if not GOJO.UseLucide then return nil end
	local ok, res = pcall(function()
		return loadstring(game:HttpGet(GOJO.LucideUrl))()
	end)
	if ok and type(res) == "table" and res.GetAsset then
		LucideModule = res
	else
		warn("[Gojo UI] load Lucide failed, using fallback glyphs")
	end
	return LucideModule
end

local function GetLucideIcon(name)
	local lucide = GetLucide()
	if not lucide then return nil end
	for _, candidate in ipairs({ name, GOJO.IconAliases[name] }) do
		local ok, asset = pcall(lucide.GetAsset, candidate)
		if ok and asset and asset.Url then
			return {
				Image = asset.Url,
				ImageRectOffset = asset.ImageRectOffset,
				ImageRectSize = asset.ImageRectSize,
				Tint = true,
			}
		end
	end
	return nil
end

-- คืน kind ("image" | "glyph"), data
local function ResolveIcon(icon)
	if icon == nil or icon == "" then return nil end
	if type(icon) == "number" then
		return "image", { Image = "rbxassetid://" .. tostring(icon) }
	end
	if type(icon) == "table" then return "image", icon end

	icon = tostring(icon)
	if icon:find("rbxassetid://", 1, true) or icon:find("rbxthumb://", 1, true)
		or icon:find("rbxasset://", 1, true) or icon:match("^https?://") then
		return "image", { Image = icon }
	end
	if icon:match("^%d+$") then
		return "image", { Image = "rbxassetid://" .. icon }
	end

	local key = string.lower(icon):gsub("^lucide:", "")
	local registered = GOJO.Icons[key]
	if registered then
		if type(registered) == "table" then return "image", registered end
		return "image", { Image = tostring(registered) }
	end

	local lucideIcon = GetLucideIcon(key)
	if lucideIcon then return "image", lucideIcon end

	return "glyph", GOJO.IconGlyphs[key] or "\u{25C8}"
end

function GOJO.CreateIcon(icon, props)
	props = props or {}
	local kind, data = ResolveIcon(icon)
	if not kind then return nil end
	local object
	if kind == "image" then
		object = New("ImageLabel", {
			Name = props.Name or "Icon",
			AnchorPoint = props.AnchorPoint,
			Position = props.Position,
			Size = props.Size or UDim2.fromOffset(18, 18),
			BackgroundTransparency = 1,
			Image = data.Image or "",
			ImageRectOffset = data.ImageRectOffset or Vector2.zero,
			ImageRectSize = data.ImageRectSize or Vector2.zero,
			ImageColor3 = props.Color or (data.Tint and Theme.Glow or Color3.new(1, 1, 1)),
			ImageTransparency = props.Transparency or 0,
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = props.ZIndex or 1,
		})
	else
		object = New("TextLabel", {
			Name = props.Name or "Icon",
			AnchorPoint = props.AnchorPoint,
			Position = props.Position,
			Size = props.Size or UDim2.fromOffset(18, 18),
			BackgroundTransparency = 1,
			Text = data,
			TextColor3 = props.Color or Theme.Glow,
			TextTransparency = props.Transparency or 0,
			TextSize = props.TextSize or 16,
			Font = Enum.Font.GothamBold,
			ZIndex = props.ZIndex or 1,
		})
	end
	return object, kind
end

local function SetIconColor(obj, color)
	if not obj then return end
	if obj:IsA("ImageLabel") then
		Tween(obj, 0.18, { ImageColor3 = color })
	else
		Tween(obj, 0.18, { TextColor3 = color })
	end
end

