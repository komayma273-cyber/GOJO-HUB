		function Tab:CreateKeybind(cfg)
			cfg = cfg or {}
			local key = cfg.Default or Enum.KeyCode.F
			local listening = false

			local f = MakeElement(cfg.Height or 46, cfg.Name)
			BuildLabels(f, cfg, "Keybind", 110, 3)
			local btn = New("TextButton", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -12, 0.5, 0),
				Size = UDim2.fromOffset(90, 28),
				BackgroundColor3 = Theme.Background,
				Text = key.Name,
				TextColor3 = Theme.Glow,
				TextSize = 11,
				Font = Enum.Font.GothamBold,
				AutoButtonColor = false,
				ZIndex = 3,
				Parent = f,
			})
			Corner(btn, GOJO.Corners.Inner)
			Stroke(btn, Theme.Line, 0.3, 1)

			btn.Activated:Connect(function()
				listening = true
				btn.Text = "..."
			end)

			Connect(UserInputService.InputBegan, function(i, processed)
				if listening then
					if i.UserInputType == Enum.UserInputType.Keyboard then
						listening = false
						if i.KeyCode ~= Enum.KeyCode.Escape then key = i.KeyCode end
						btn.Text = key.Name
						if cfg.Changed then task.spawn(cfg.Changed, key) end
					end
					return
				end
				if not processed and i.KeyCode == key and cfg.Callback then
					task.spawn(cfg.Callback, key)
				end
			end)

			return {
				Frame = f,
				Get = function() return key end,
				Set = function(_, k)
					if typeof(k) == "EnumItem" then key = k btn.Text = k.Name end
				end,
			}
		end

