GOJO.Effects = {}

function GOJO.Effects:Glow(obj, color)
	if not obj or not obj.Parent then return end
	local st = obj:FindFirstChild("GOJO_Glow")
	if not st then
		st = New("UIStroke", {
			Name = "GOJO_Glow",
			Thickness = 1,
			Transparency = 0.8,
			Color = color or Theme.Primary,
			Parent = obj,
		})
	end
	Tween(st, 0.25, { Transparency = 0.15, Thickness = 2 })
	return st
end

function GOJO.Effects:Pulse(obj)
	if not obj then return end
	local sc = obj:FindFirstChild("GOJO_PulseScale")
	if not sc then
		sc = New("UIScale", { Name = "GOJO_PulseScale", Scale = 1, Parent = obj })
	end
	task.spawn(function()
		while obj.Parent do
			Tween(sc, 0.7, { Scale = 1.03 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			task.wait(0.7)
			if not obj.Parent then break end
			Tween(sc, 0.7, { Scale = 1 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			task.wait(0.7)
		end
	end)
end

function GOJO.Effects:Shake(obj, strength)
	if not obj then return end
	strength = strength or 4
	local origin = obj.Position
	task.spawn(function()
		for _ = 1, 8 do
			if not obj.Parent then return end
			obj.Position = UDim2.new(
				origin.X.Scale, origin.X.Offset + math.random(-strength, strength),
				origin.Y.Scale, origin.Y.Offset + math.random(-strength, strength)
			)
			task.wait(0.035)
		end
		if obj.Parent then obj.Position = origin end
	end)
end

function GOJO.Effects:Rainbow(obj)
	if not obj then return end
	local g = obj:FindFirstChild("GOJO_Rainbow")
	if not g then
		g = New("UIGradient", {
			Name = "GOJO_Rainbow",
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 70)),
				ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 210, 70)),
				ColorSequenceKeypoint.new(0.4, Color3.fromRGB(80, 255, 120)),
				ColorSequenceKeypoint.new(0.6, Color3.fromRGB(80, 180, 255)),
				ColorSequenceKeypoint.new(0.8, Color3.fromRGB(170, 90, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 80, 180)),
			}),
			Parent = obj,
		})
	end
	task.spawn(function()
		while obj.Parent do
			g.Rotation = (g.Rotation + 2) % 360
			task.wait(0.03)
		end
	end)
	return g
end

-- พลังคำสาปลอยขึ้นในกรอบ (เหมือน Fire ของ KRYVEX)
function GOJO.Effects:Aura(container)
	if not container then return end
	local holder = container:FindFirstChild("GOJO_Aura")
	if holder then return holder end
	holder = New("Frame", {
		Name = "GOJO_Aura",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 5,
		Parent = container,
	})
	task.spawn(function()
		while holder.Parent do
			local size = math.random(3, 6)
			local dot = New("Frame", {
				Size = UDim2.fromOffset(size, size),
				Position = UDim2.new(math.random(5, 95) / 100, 0, 1, 0),
				BackgroundColor3 = (math.random() < 0.5) and Theme.Primary or Theme.Glow,
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				ZIndex = 6,
				Parent = holder,
			})
			Round(dot)
			Tween(dot, math.random(14, 24) / 10, {
				Position = UDim2.new(dot.Position.X.Scale, 0, -0.1, 0),
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(1, 1),
			})
			task.delay(2.6, function() dot:Destroy() end)
			task.wait(math.random(12, 26) / 100)
		end
	end)
	return holder
end

GOJO.Effects.Fire = GOJO.Effects.Aura

