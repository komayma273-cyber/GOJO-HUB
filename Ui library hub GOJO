			ZIndex = 4,
			Parent = Header,
		})
		local g = New("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Theme.PrimaryDark),
				ColorSequenceKeypoint.new(0.5, Theme.Glow),
				ColorSequenceKeypoint.new(1, Theme.PrimaryDark),
			}),
