		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Active = false,
		ZIndex = 25,
		Parent = Main,
	})

	if FX.Particles then
		local colors = { Theme.Primary, Theme.Glow, Color3.new(1, 1, 1) }
		local ps = {}
		for i = 1, 16 do
			local size = math.random(2, 4)
			local d = New("Frame", {
				Size = UDim2.fromOffset(size, size),
				BackgroundColor3 = colors[math.random(#colors)],
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Parent = FXLayer,
			})
			Round(d)
			ps[i] = {
				F = d, X = 0.04 + math.random() * 0.92,
				Speed = 0.03 + math.random() * 0.05, Off = math.random(),
				Sway = 3 + math.random() * 7, Rate = 0.7 + math.random() * 1.3,
				Ph = math.random() * 6.28,
			}
		end
		table.insert(updaters, function(t)
			for _, p in ipairs(ps) do
				local fr = (t * p.Speed + p.Off) % 1
				p.F.Position = UDim2.new(p.X, math.sin(t * p.Rate + p.Ph) * p.Sway, 1 - fr, 0)
				p.F.BackgroundTransparency = 0.45 + 0.5 * math.abs(fr * 2 - 1)
			end
		end)
	end

	if FX.HeaderLine then
		local line = New("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0, 2),
