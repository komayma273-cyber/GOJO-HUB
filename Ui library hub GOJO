				TextXAlignment = Enum.TextXAlignment.Right,
				ZIndex = 3,
				Parent = f,
			})

			local Bar = New("Frame", {
				Position = UDim2.fromOffset(14, 43),
				Size = UDim2.new(1, -28, 0, 6),
				BackgroundColor3 = Theme.ToggleOff,
				BorderSizePixel = 0,
				ZIndex = 3,
				Parent = f,
			})
