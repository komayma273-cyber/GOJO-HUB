			MainStroke.Thickness = 2.1 + 0.8 * (0.5 + 0.5 * math.sin(t * 1.8))
		end)
	end

	do
		local clock = 0
		Connect(RunService.Heartbeat, function(dt)
			clock += dt
			local rot = (clock * 70) % 360
			for _, g in ipairs(gradients) do
				if g.Parent then g.Rotation = rot end
			end
			for _, fn in ipairs(updaters) do fn(clock, dt) end
		end)
