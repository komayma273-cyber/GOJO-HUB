			box.Focused:Connect(function() Tween(st, 0.15, { Color = Theme.Primary, Transparency = 0 }) end)
			box.FocusLost:Connect(function(enter)
				Tween(st, 0.15, { Color = Theme.Line, Transparency = 0.3 })
