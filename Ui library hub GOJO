	local function HoverColor(btn, normal, hover)
		btn.MouseEnter:Connect(function() Tween(btn, 0.15, { BackgroundColor3 = hover }) end)
		btn.MouseLeave:Connect(function() Tween(btn, 0.15, { BackgroundColor3 = normal }) end)
